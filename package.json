{
  "name": "londan-pos-new",
  "private": true,
  "version": "1.0.0",
  "description": "برنامج الكاشير والمحاسبة الذكي لبوتيك لندن للأزياء",
  "author": "شركة محور <contact@mehwar.net>",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "dist:win": "vite build && electron-builder --win portable --x64",
    "dist:win-installer": "vite build && electron-builder --win nsis --x64",
    "dist:dir": "vite build && electron-builder --dir"
  },
  "build": {
    "appId": "com.mehwar.londanpos",
    "productName": "بوتيك لندن للأزياء",
    "artifactName": "Londan-POS-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/app-icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "بوتيك لندن للأزياء"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.1.2",
    "vite": "^6.2.0"
  }
}
